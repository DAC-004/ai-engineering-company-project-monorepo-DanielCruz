# JWT signing secret - required. Never commit a real production secret.
SECRET_KEY=change-me-to-a-long-random-string

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT signing algorithm (python-jose). Default HS256 is appropriate for HMAC secrets.
JWT_ALGORITHM=HS256

# Optional override for TinyDB JSON file path (defaults to services/api/data/auth.json)
# TINYDB_PATH=

# Required. Supabase PostgreSQL transaction-pooler URI from Connect → Direct → Transaction pooler → URI.
# Never commit the real connection string.
# Example: postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Capture-phase telemetry destination (stub today; real storage later).
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# HealthCore RAG. Local BAAI/bge-small-en-v1.5 + Qwen2.5-3B-Instruct by default.
# Optional remote keys stay empty unless a gateway is actually configured.
# LLM_API_KEY=
# LLM_API_URL=
EMBEDDING_VECTOR_SIZE=384
# QDRANT_URL=http://127.0.0.1:6333
RAG_MIN_SCORE=0.45

# Agent ticket reads go through the MCP server. The resource URL is the exact
# audience and the connect URL. /mcp and /mcp/ are not interchangeable.
# MCP_RESOURCE_URL=http://127.0.0.1:3001/mcp
# MCP_AUTH_ISSUER=https://your-tenant.logto.app/oidc
# Prefer a pre-issued token, or the agent machine-to-machine id and secret.
# That application is granted only healthcore:mcp and incidents:read.
# MCP_AGENT_ACCESS_TOKEN=
# MCP_AGENT_CLIENT_ID=
# MCP_AGENT_CLIENT_SECRET=

