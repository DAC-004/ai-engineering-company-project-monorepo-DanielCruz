# JWT signing secret - required. Never commit a real production secret.
SECRET_KEY=change-me-to-a-long-random-string

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT signing algorithm (python-jose). Default HS256 is appropriate for HMAC secrets.
JWT_ALGORITHM=HS256

# Optional override for TinyDB JSON file path (defaults to services/api/data/auth.json)
# TINYDB_PATH=

# Required for inventory SQLModel storage.
# Local Docker Compose uses SQLite (see the repository-root .env.example).
# Outside Docker this may be the Supabase PostgreSQL transaction-pooler URI
# (Connect → Direct → Transaction pooler → URI). Never commit the real connection string.
# Example: postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Comma-separated browser origins. Includes backoffice port 3001 for Docker.
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:5500,http://localhost:5500,null

