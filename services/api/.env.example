# JWT signing secret - required. Never commit a real production secret.
SECRET_KEY=change-me-to-a-long-random-string

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT signing algorithm (python-jose). Default HS256 is appropriate for HMAC secrets.
JWT_ALGORITHM=HS256

# Optional override for TinyDB JSON file path (defaults to services/api/data/auth.json)
# TINYDB_PATH=

# AUTH-03 — Resend transactional email (required to send real password-reset emails)
RESEND_API_KEY=
# Sender must be a Resend-allowed From address.
# For development without a verified custom domain, use the Resend onboarding sender:
RESEND_FROM_EMAIL=HealthCore <onboarding@resend.dev>
# Public frontend origin used to build /reset-password?token=… links
FRONTEND_BASE_URL=http://localhost:3000
# Reset token lifetime in minutes (must be between 15 and 60)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Optional, local-only: real inbox used as the registered user for AUTH-03 inbox validation.
# Do not commit a real address. Not required for normal API runtime.
# AUTH03_TEST_RECIPIENT=
