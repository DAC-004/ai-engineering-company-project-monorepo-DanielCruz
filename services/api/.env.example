# JWT signing secret - required. Never commit a real production secret.
SECRET_KEY=change-me-to-a-long-random-string

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT signing algorithm (python-jose). Default HS256 is appropriate for HMAC secrets.
JWT_ALGORITHM=HS256

# Optional override for TinyDB JSON file path (defaults to services/api/data/auth.json)
# TINYDB_PATH=

# Optional override for supplier TinyDB JSON file path (defaults to services/api/data/suppliers.json)
# SUPPLIERS_DB_PATH=

# Required for inventory SQLModel storage.
# Local Docker Compose uses SQLite (see the repository-root `.env.example`).
# Outside Docker this may be the Supabase PostgreSQL transaction-pooler URI
# (Connect → Direct → Transaction pooler → URI). Never commit the real connection string.
# Example: postgresql://postgres.PROJECT:PASSWORD@HOST:6543/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Comma-separated browser origins (Docker: include 3001 backoffice and 3000/3002 tracker).
# CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001,http://127.0.0.1:3002,http://localhost:3002,http://127.0.0.1:5500,http://localhost:5500,null

# Capture-phase telemetry destination (stub today; real storage later).
TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# Fixed window for endpoints that invoke a model. Defaults are 30 requests / 60 seconds.
# MODEL_RATE_LIMIT_REQUESTS=30
# MODEL_RATE_LIMIT_WINDOW_SECONDS=60

# Required before the API creates the three RFP demonstration accounts.
# Set a unique value in the untracked .env. Do not commit that value.
RFP_DEMONSTRATION_PASSWORD=

# HealthCore RAG. Local BAAI/bge-small-en-v1.5 + Qwen2.5-3B-Instruct by default.
# Optional remote keys stay empty unless a gateway is actually configured.
# LLM_API_KEY=
# LLM_API_URL=
EMBEDDING_VECTOR_SIZE=384
# QDRANT_URL=http://127.0.0.1:6333
RAG_MIN_SCORE=0.45

# Agent ticket reads go through the MCP server. The resource URL is the exact
# audience and the connect URL. /mcp and /mcp/ are not interchangeable.
# MCP_RESOURCE_URL=http://127.0.0.1:3001/mcp
# MCP_AUTH_ISSUER=https://your-tenant.logto.app/oidc
# Prefer a pre-issued token, or the agent machine-to-machine id and secret.
# That application is granted only healthcore:mcp and incidents:read.
# MCP_AGENT_ACCESS_TOKEN=
# MCP_AGENT_CLIENT_ID=
# MCP_AGENT_CLIENT_SECRET=

# AUTH-03 — Resend transactional email (required to send real password-reset emails)
RESEND_API_KEY=
# Sender must be a Resend-allowed From address.
# For development without a verified custom domain, use the Resend onboarding sender:
RESEND_FROM_EMAIL=HealthCore <onboarding@resend.dev>
# Public frontend origin used to build /reset-password?token=… links
FRONTEND_BASE_URL=http://localhost:3000
# Reset token lifetime in minutes (must be between 15 and 60)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Optional, local-only: real inbox used as the registered user for AUTH-03 inbox validation.
# Do not commit a real address. Not required for normal API runtime.
# AUTH03_TEST_RECIPIENT=

# Redis broker and Celery result backend (docker compose service `redis`).
REDIS_URL=redis://localhost:6379/0
# Optional override for incident upload/result storage under services/api/data/.
# INCIDENT_DATA_DIR=
