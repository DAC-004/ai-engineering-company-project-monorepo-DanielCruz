# JWT signing secret - required. Never commit a real production secret.
SECRET_KEY=change-me-to-a-long-random-string

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT signing algorithm (python-jose). Default HS256 is appropriate for HMAC secrets.
JWT_ALGORITHM=HS256

# Optional override for TinyDB JSON file path (defaults to services/api/data/auth.json)
# TINYDB_PATH=
