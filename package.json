{
  "name": "healthcore-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "HealthCore AI Engineering monorepo \u2014 Milestone 1 static site at repo root",
  "scripts": {
    "build:css": "tailwindcss -i ./styles/site.css -o ./assets/site.css --minify",
    "build": "npm run build:css",
    "start": "http-server . -p 3000 -a 0.0.0.0 -c-1",
    "typecheck": "tsc --noEmit",
    "build:milestone2": "tsc --project tsconfig.build.json",
    "demo": "tsx src/demo.ts",
    "test": "tsx --test src/tests/**/*.test.ts",
    "verify:milestone2": "npm run typecheck && npm run test && npm run build:milestone2",
    "vercel": "vercel",
    "vercel:login": "vercel login",
    "vercel:link": "vercel link --scope danielcruz-glitchs-projects",
    "vercel:deploy": "vercel deploy --prod --yes --scope danielcruz-glitchs-projects",
    "vercel:whoami": "vercel whoami"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vercel": "65.12.1"
  },
  "overrides": {
    "ajv@8.6.3": "8.20.0",
    "js-yaml@4.1.1": "4.3.2",
    "tar@7.5.11": "7.5.22",
    "smol-toml@1.5.2": "1.9.1",
    "path-to-regexp@6.1.0": "6.3.0",
    "path-to-regexp@8.3.0": "8.4.2",
    "zod@<4.6.6": "4.6.7",
    "glob@>=9 <=14.0.1": "14.0.4",
    "minimatch@>=7 <11.0.1": "11.0.5",
    "@fastify/busboy@<3.2.2": "3.2.5",
    "undici@<6.29.1": "6.29.1",
    "esbuild@>=0.27.3 <0.28.1": "0.28.2"
  }
}
