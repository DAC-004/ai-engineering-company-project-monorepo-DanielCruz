# HealthCore API base URL (AUTH-01 FastAPI service)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Inventory API base URL (same HealthCore FastAPI process; /inventory routes)
NEXT_PUBLIC_INVENTORY_API_URL=http://localhost:8000

# Telemetry capture destination (stub POST /telemetry/events today)
NEXT_PUBLIC_TELEMETRY_ENDPOINT=http://localhost:8000/telemetry/events

# 4Geeks Talent Tracker REST API for the candidate pipeline.
# This is separate from NEXT_PUBLIC_API_BASE_URL so login, profile, and
# inventory keep calling the HealthCore API.
NEXT_PUBLIC_TRACKER_API_BASE_URL=https://playground.4geeks.com/tracker/api/v1
