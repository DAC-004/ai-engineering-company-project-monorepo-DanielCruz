# Browser-visible API prefix. Relative so the browser stays on the Next.js origin.
# The Next.js server rewrites /backend/* to API_PROXY_TARGET (not sent to the browser).
NEXT_PUBLIC_API_BASE_URL=/backend

# Inventory uses the same FastAPI process and the same same-origin prefix.
NEXT_PUBLIC_INVENTORY_API_URL=/backend

# Server-side only. Docker Compose: http://backend:8000
# Local non-Docker: http://127.0.0.1:8000
API_PROXY_TARGET=http://127.0.0.1:8000
