# HealthCore RAG — copy to .env only if you need optional remote overrides.
# Default path is local and credential-free:
#   embedding: BAAI/bge-small-en-v1.5 (FastEmbed ONNX, 384-d)
#   generation: Qwen2.5-3B-Instruct (llama-cpp GGUF)
# Never commit real secrets.

# Optional remote OpenAI-compatible override. Leave empty to use local models.
# LLM_API_KEY=
# LLM_API_URL=
# LLM_MODEL=
# EMBEDDING_MODEL=
# EMBEDDING_API_URL=
# EMBEDDING_API_KEY=
# GENERATION_MODEL=
# GENERATION_API_URL=
# GENERATION_API_KEY=

# FastEmbed BAAI/bge-small-en-v1.5 width. Recreate the collection if changed.
EMBEDDING_VECTOR_SIZE=384

# Qdrant. Prefer Docker Compose or Qdrant Cloud when available.
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
# QDRANT_PATH=data/process/qdrant_storage

# Retrieval threshold. Documented in docs/rag/rag-design.md.
RAG_MIN_SCORE=0.45
