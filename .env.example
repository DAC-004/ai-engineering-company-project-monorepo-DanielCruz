# Copy to `.env` at the repository root. Never commit `.env`.
#
# Docker Compose interpolates these names into service `environment:` blocks.
# Values below are placeholders, not production credentials.

# Backend identity and inventory
SECRET_KEY=replace-with-a-long-random-dev-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

# TinyDB stays responsible for users / auth UUIDs (container path; bind-mounted).
TINYDB_PATH=/app/services/api/data/auth.json

# Local Docker inventory database (SQLite). Outside Docker, DATABASE_URL may still
# be a Supabase/PostgreSQL URI. Do not move inventory data into TinyDB.
DATABASE_URL=sqlite:////app/services/api/data/inventory.db

# Browser origins for CORS. Same-origin Next.js proxy is primary; 3001 is required
# if a browser talks to FastAPI directly from the backoffice origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5500,http://127.0.0.1:5500,null

# Next.js server-side proxy target. This is the Docker Compose service name.
# Local non-Docker: http://127.0.0.1:8000
API_PROXY_TARGET=http://backend:8000

# Browser-visible same-origin prefix. Do not put a Docker hostname here.
NEXT_PUBLIC_API_BASE_URL=/backend
NEXT_PUBLIC_INVENTORY_API_URL=/backend

# File-watch polling for Docker Desktop bind mounts (Windows/macOS).
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
