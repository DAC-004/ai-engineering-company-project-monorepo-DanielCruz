# Copy to `.env` at the repository root. Never commit `.env`.
#
# Docker Compose interpolates these names into service `environment:` blocks.
# Values below are placeholders, not production credentials.

# --- Docker Compose (API + public website + supplier backoffice UI) ---

SECRET_KEY=replace-with-a-long-random-dev-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

TINYDB_PATH=/app/services/api/data/auth.json
DATABASE_URL=sqlite:////app/services/api/data/inventory.db

# Include 3010 when the Compose UI maps public website to host 3010 (tracker keeps 3000).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3010,http://127.0.0.1:3010,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:5500,http://127.0.0.1:5500,null

API_PROXY_TARGET=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=/backend
NEXT_PUBLIC_INVENTORY_API_URL=/backend

WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

QDRANT_URL=http://qdrant:6333
RFP_DEMONSTRATION_PASSWORD=replace-with-a-unique-docker-dev-secret

# --- HealthCore RAG (host `uv` workflow; optional in Docker when using Qdrant service) ---

EMBEDDING_VECTOR_SIZE=384
RAG_MIN_SCORE=0.45
# QDRANT_PATH=data/process/qdrant_storage

# Optional remote OpenAI-compatible override. Leave empty to use local models.
# LLM_API_KEY=
# LLM_API_URL=

# MODEL_RATE_LIMIT_REQUESTS=30
# MODEL_RATE_LIMIT_WINDOW_SECONDS=60
